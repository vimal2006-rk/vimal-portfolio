{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build && cp -r dist/* ../",
  "outputDirectory": ".",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
